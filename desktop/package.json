{
  "name": "soop-ai-desktop",
  "productName": "Soop AI Desktop",
  "version": "0.1.0",
  "description": "Soop AI desktop client and project workspace",
  "author": "Soop AI",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build": "node build.cjs",
    "start": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/search": "6.7.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "lucide": "1.77.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0"
  },
  "build": {
    "appId": "ai.soop.desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "project.cjs",
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://soop-ai-c5q5.onrender.com/downloads/desktop/"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.3"
  }
}
